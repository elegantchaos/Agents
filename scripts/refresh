#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

# Each plugin that needs agt carries its own copy of ensure-agt.sh; report any that have drifted.
canonical=plugins/baseline/skills/refresh/scripts/ensure-agt.sh
for copy in plugins/*/skills/*/scripts/ensure-agt.sh; do
  cmp -s "$canonical" "$copy" || echo "warning: $copy differs from $canonical" >&2
done

agt=$("$root/$canonical" --update)
"$agt" skills sync --all
"$agt" skills link

# Let both runtimes' sandboxes write the caches that Swift validation needs.
"$root/scripts/configure-sandboxes"

# Install, or refresh, every plugin listed in each runtime's marketplace.
# Claude Code loads plugins in place; Codex runs from a cached copy that `plugin add` replaces.
if command -v claude >/dev/null; then
  marketplace=$(jq -r .name .claude-plugin/marketplace.json)
  claude plugin marketplace add "$root"
  claude plugin marketplace update "$marketplace"
  for plugin in $(jq -r '.plugins[].name' .claude-plugin/marketplace.json); do
    claude plugin install "$plugin@$marketplace"
    claude plugin update "$plugin@$marketplace"
  done
else
  echo "claude not found on PATH; skipping Claude Code plugins"
fi

if command -v codex >/dev/null; then
  marketplace=$(jq -r .name .agents/plugins/marketplace.json)
  codex plugin marketplace add "$root"
  for plugin in $(jq -r '.plugins[].name' .agents/plugins/marketplace.json); do
    codex plugin add "$plugin@$marketplace"
  done
else
  echo "codex not found on PATH; skipping Codex plugins"
fi
