#!/usr/bin/env python3
"""Allows agent sandboxes to write where Swift validation needs to, outside the project.

`agt validate` runs inside Claude Code's and Codex's sandboxes. Xcode always writes package manifests to
SwiftPM's cache, and compiles manifests that import macro support with the per-user clang module cache,
so both runtimes must allow writes there. The paths are machine-specific, so this script computes them and
merges them into each runtime's user configuration, leaving every other setting alone. It is idempotent,
and backs a file up before changing it.
"""

import json
import os
import re
import shutil
import subprocess
import tomllib
from pathlib import Path


def writable_paths() -> list[str]:
    """Returns the directories Swift validation must be able to write outside the project."""
    user_cache = subprocess.run(["getconf", "DARWIN_USER_CACHE_DIR"], capture_output=True, text=True, check=True).stdout.strip()
    return [
        str(Path.home() / "Library/Caches/org.swift.swiftpm"),
        str(Path(user_cache) / "clang/ModuleCache"),
    ]


def merged(existing: list[str], paths: list[str]) -> list[str]:
    """Returns the existing entries followed by any missing paths."""
    return existing + [path for path in paths if path not in existing]


def save(path: Path, text: str) -> None:
    """Backs up the file, then replaces its contents."""
    if path.exists():
        shutil.copy2(path, path.with_name(path.name + ".bak"))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)


def configure_claude(paths: list[str]) -> None:
    """Merges the paths into `sandbox.filesystem.allowWrite` in Claude Code's user settings."""
    home = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    settings_path = home / "settings.json"
    settings = json.loads(settings_path.read_text()) if settings_path.exists() else {}
    filesystem = settings.setdefault("sandbox", {}).setdefault("filesystem", {})
    existing = filesystem.get("allowWrite", [])
    updated = merged(existing, paths)
    if updated == existing:
        print(f"claude: {settings_path} already allows the Swift validation caches")
        return
    filesystem["allowWrite"] = updated
    save(settings_path, json.dumps(settings, indent=2) + "\n")
    print(f"claude: added Swift validation caches to sandbox.filesystem.allowWrite in {settings_path}")


def configure_codex(paths: list[str]) -> None:
    """Merges the paths into `sandbox_workspace_write.writable_roots` in Codex's user configuration."""
    home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    config_path = home / "config.toml"
    text = config_path.read_text() if config_path.exists() else ""
    config = tomllib.loads(text)
    existing = config.get("sandbox_workspace_write", {}).get("writable_roots", [])
    updated = merged(existing, paths)
    if updated == existing:
        print(f"codex: {config_path} already allows the Swift validation caches")
        return

    line = "writable_roots = " + json.dumps(updated)
    header = re.search(r"^\[sandbox_workspace_write\][ \t]*$", text, flags=re.MULTILINE)
    if header is None:
        separator = "\n\n" if text.strip() else ""
        text = text.rstrip("\n") + f"{separator}[sandbox_workspace_write]\n{line}\n"
    else:
        body_start = header.end()
        next_table = re.search(r"^\[", text[body_start:], flags=re.MULTILINE)
        body_end = body_start + next_table.start() if next_table else len(text)
        body = text[body_start:body_end]
        roots = re.search(r"^writable_roots[ \t]*=.*$", body, flags=re.MULTILINE)
        if roots is None:
            body = f"\n{line}" + body
        elif roots.group(0).count("[") == roots.group(0).count("]"):
            body = body[: roots.start()] + line + body[roots.end() :]
        else:
            raise SystemExit(f"codex: {config_path} has a multi-line writable_roots; add {paths} to it by hand")
        text = text[:body_start] + body + text[body_end:]

    tomllib.loads(text)
    save(config_path, text)
    print(f"codex: added Swift validation caches to sandbox_workspace_write.writable_roots in {config_path}")


if __name__ == "__main__":
    paths = writable_paths()
    configure_claude(paths)
    configure_codex(paths)
